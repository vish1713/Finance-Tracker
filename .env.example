# ---- Postgres ----
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_tracker
POSTGRES_PORT=5432

# ---- Backend (NestJS) ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_tracker?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

REDIS_HOST=localhost
REDIS_PORT=6379

CORS_ORIGIN=http://localhost:3000

# Storage: "s3" | "cloudinary"
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=finance-tracker-uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (Maildev locally: smtp on 1025, web UI on 1080)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Finance Tracker <no-reply@finance-tracker.local>"
MAIL_ENABLED=true

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
